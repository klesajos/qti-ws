{
  "extraKnownMarketplaces": {
    "qti-ws": {
      "source": {
        "source": "github",
        "repo": "klesajos/qti-ws"
      }
    }
  },
  "enabledPlugins": {
    "2048-dev@qti-ws": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-go.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/run-tests.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
